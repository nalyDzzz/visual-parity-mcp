{
  "name": "visual-parity-mcp",
  "version": "0.1.9",
  "description": "MCP server and CLI for visual parity QA between reference and candidate web pages.",
  "type": "module",
  "bin": {
    "visual-parity": "dist/cli.js",
    "visual-parity-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nalyDzzz/visual-parity-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nalyDzzz/visual-parity-mcp/issues"
  },
  "homepage": "https://github.com/nalyDzzz/visual-parity-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev:mcp": "tsx src/mcp.ts",
    "compare": "tsx src/cli.ts compare",
    "routes": "tsx src/cli.ts routes",
    "inspect": "tsx src/cli.ts inspect",
    "check": "npm run build && node dist/cli.js --help",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "perf:smoke": "node scripts/perf-smoke-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "playwright",
    "visual-regression",
    "visual-testing",
    "visual-diff",
    "frontend",
    "website-migration",
    "nextjs",
    "hubspot"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
