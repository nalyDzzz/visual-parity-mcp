{
  "name": "visual-parity-mcp",
  "version": "0.1.4",
  "description": "MCP server and CLI for visual parity QA between reference and candidate web pages.",
  "type": "module",
  "bin": {
    "visual-parity": "dist/cli.js",
    "visual-parity-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nalyDzzz/visual-parity-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nalyDzzz/visual-parity-mcp/issues"
  },
  "homepage": "https://github.com/nalyDzzz/visual-parity-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev:mcp": "tsx src/mcp.ts",
    "compare": "tsx src/cli.ts compare",
    "routes": "tsx src/cli.ts routes",
    "inspect": "tsx src/cli.ts inspect",
    "check": "npm run build && node dist/cli.js --help",
    "smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "playwright",
    "visual-regression",
    "visual-testing",
    "visual-diff",
    "frontend",
    "website-migration",
    "nextjs",
    "hubspot"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "commander": "latest",
    "pixelmatch": "latest",
    "playwright": "latest",
    "pngjs": "latest",
    "sharp": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pngjs": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
